# ---------------------------------------------------------------------------
# Database
# Local dev (docker-compose up -d db):
#   DATABASE_URL="postgresql://nemus:nemus@localhost:5432/nemus_tenders"
# Production (Supabase/Neon): use the pooled connection string for DATABASE_URL
# and the direct (non-pooled) connection string for DIRECT_URL (Prisma migrations
# need a direct connection; the app can run against the pooler).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://nemus:nemus@localhost:5432/nemus_tenders"
DIRECT_URL="postgresql://nemus:nemus@localhost:5432/nemus_tenders"

# ---------------------------------------------------------------------------
# Auth (NextAuth)
# Generate a secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Seed script creates the first admin user from these (see prisma/seed.ts).
# Do not commit real credentials — this file is a template only.
ADMIN_EMAIL="iris@nemus.africa"
ADMIN_NAME="Iris"
ADMIN_PASSWORD="change-me-before-first-run"

# ---------------------------------------------------------------------------
# Jornal Notícias (flipbook-snoticias.app.co.mz) — paid subscription credentials.
# NEVER hard-code these or commit them. Required only for the JornalNoticiasAdapter.
# ---------------------------------------------------------------------------
NOTICIAS_EMAIL=""
NOTICIAS_PASSWORD=""

# ---------------------------------------------------------------------------
# Ingestion trigger (Refresh button -> GitHub Actions dispatch for the
# Playwright-heavy Jornal Notícias adapter; see docs/ARCHITECTURE.md).
# A fine-grained PAT with "Actions: write" on this repo only.
# ---------------------------------------------------------------------------
GITHUB_DISPATCH_TOKEN=""
GITHUB_DISPATCH_REPO="dincassamo98/nemus-tender-intelligence"

# ---------------------------------------------------------------------------
# File storage for downloaded documents (raw PDFs/images).
# "local" writes to ./storage. WARNING: on Vercel/serverless or a GitHub
# Actions runner this is EPHEMERAL — fine for local dev only. A persistent
# deployment needs an S3-compatible driver implemented in lib/storage —
# see docs/ARCHITECTURE.md "Known gaps".
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# ---------------------------------------------------------------------------
# Vercel Cron authorization for the lightweight-sources cron route
# (app/api/cron/lightweight). Vercel sets this automatically in production;
# generate one yourself for local testing: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=""
